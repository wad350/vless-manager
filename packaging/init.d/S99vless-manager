#!/bin/sh

BIN=/opt/bin/vless-manager
DATA_DIR=/opt/etc/vless-manager
PID_FILE=/opt/var/run/vless-manager.pid
LOG_FILE=/opt/var/log/vless-manager.log
MAX_LOG_BYTES=524288

# clean_routing — remove all iptables/ip-rule state vless-manager may have
# installed. The manager's own DisableGlobalRoute runs on graceful shutdown,
# but if the process is kill -9'd we have to mop up.
clean_routing() {
    # TUN-mode mangle chain (current architecture, v1.5+)
    iptables -t mangle -D PREROUTING -i br0 -j VLESS_TPROXY 2>/dev/null
    iptables -t mangle -D OUTPUT -j VLESS_TPROXY 2>/dev/null
    iptables -t mangle -F VLESS_TPROXY 2>/dev/null
    iptables -t mangle -X VLESS_TPROXY 2>/dev/null
    ip rule del fwmark 0x1 lookup 100 2>/dev/null
    ip rule del fwmark 0x9911 lookup main 2>/dev/null
    ip route flush table 100 2>/dev/null
    # TUN-mode INPUT/FORWARD/POSTROUTING rules
    iptables -D INPUT -i tun0 -j ACCEPT 2>/dev/null
    iptables -D FORWARD -i br0 -o tun0 -j ACCEPT 2>/dev/null
    iptables -D FORWARD -i tun0 -j ACCEPT 2>/dev/null
    iptables -t nat -D POSTROUTING -o tun0 -j RETURN 2>/dev/null
    ip link del tun0 2>/dev/null

    # Legacy TPROXY-mode DIVERT chain (pre-1.5 builds)
    iptables -t mangle -D PREROUTING -p tcp -m socket -j VLESS_DIVERT 2>/dev/null
    iptables -t mangle -D PREROUTING -p udp -m socket -j VLESS_DIVERT 2>/dev/null
    iptables -t mangle -F VLESS_DIVERT 2>/dev/null
    iptables -t mangle -X VLESS_DIVERT 2>/dev/null
    # Remove legacy br-lan rule (pre-1.4.1 builds used wrong interface name)
    iptables -t mangle -D PREROUTING -i br-lan -j VLESS_TPROXY 2>/dev/null
    ip rule del fwmark 0x1/0x1 lookup 100 2>/dev/null

    # Legacy NAT REDIRECT chain (pre-1.3 builds)
    iptables -t nat -D PREROUTING -i br0 -j VLESS_REDIR 2>/dev/null
    iptables -t nat -F VLESS_REDIR 2>/dev/null
    iptables -t nat -X VLESS_REDIR 2>/dev/null

    # Legacy TUN-mode ip-rule artifacts (pre-1.2 builds)
    for p in 2 4 5 6; do
        while ip rule del pref $p 2>/dev/null; do :; done
    done
    ip route flush table 200 2>/dev/null
    iptables -t nat -D POSTROUTING -o tun0 -j MASQUERADE 2>/dev/null
}

start() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat $PID_FILE)" 2>/dev/null; then
        echo "vless-manager already running"
        return 0
    fi
    clean_routing
    echo "Starting vless-manager..."
    mkdir -p /opt/var/run /opt/var/log "$DATA_DIR"
    if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE")" -gt "$MAX_LOG_BYTES" ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.1"
    fi
    "$BIN" -data-dir "$DATA_DIR" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "Started (PID $!)"
}

stop() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "Stopping vless-manager (PID $PID)..."
            kill "$PID"
            sleep 1
            kill -0 "$PID" 2>/dev/null && kill -9 "$PID"
        fi
        rm -f "$PID_FILE"
    fi
    clean_routing
    echo "Stopped"
}

status() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat $PID_FILE)" 2>/dev/null; then
        echo "vless-manager running (PID $(cat $PID_FILE))"
    else
        echo "vless-manager stopped"
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
