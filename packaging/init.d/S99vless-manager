#!/bin/sh

export PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Use the tested low-memory Go profile on MIPS; leave ARM64 defaults unchanged.
case "$(uname -m)" in
    mips*)
        export GOMEMLIMIT="${GOMEMLIMIT:-32MiB}"
        export GOGC="${GOGC:-50}"
        CPU_LIMIT=$(awk '
            /^system type[[:space:]]*:/ && /MediaTek MT7621([[:space:]]|$)/ { mt7621 = 1 }
            /^processor[[:space:]]*:/ { logical++ }
            /^core[[:space:]]*:/ { cores[$NF] = 1 }
            END {
                for (core in cores) physical++
                if (mt7621 && logical == 4 && physical == 2) print 2
            }
        ' /proc/cpuinfo 2>/dev/null)
        # Bounded MIPS32r2 crypto backends are tested on native MT7621 TPROXY.
        # Their own ISA checks still fall back to Go on unsupported processors.
        if [ "$CPU_LIMIT" = "2" ]; then
            export VLESS_MANAGER_MIPS_CHACHA20="${VLESS_MANAGER_MIPS_CHACHA20:-auto}"
            export VLESS_MANAGER_MIPS_POLY1305="${VLESS_MANAGER_MIPS_POLY1305:-auto}"
            # Four VPEs share two physical cores; retain the measured Go limit.
            export GOMAXPROCS="${GOMAXPROCS:-2}"
        else
            export VLESS_MANAGER_MIPS_CHACHA20="${VLESS_MANAGER_MIPS_CHACHA20:-generic}"
        fi
        ;;
esac

BIN=/opt/bin/vless-manager
DATA_DIR=/opt/etc/vless-manager
RUNTIME_DIR=${VLESS_MANAGER_RUNTIME_DIR:-/tmp/vless-manager}
PID_FILE="$RUNTIME_DIR/manager.pid"
LEGACY_PID_FILE=/opt/var/run/vless-manager.pid
# A newly installed script must still be able to stop the old running build.
if [ -f "$LEGACY_PID_FILE" ] && kill -0 "$(cat "$LEGACY_PID_FILE")" 2>/dev/null; then
    if [ ! -f "$PID_FILE" ] || ! kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        PID_FILE="$LEGACY_PID_FILE"
    fi
fi
LOG_FILE="$RUNTIME_DIR/process.log"
MAX_LOG_BYTES=65536

# clean_routing — remove all iptables/ip-rule state vless-manager may have
# installed. The manager's own DisableGlobalRoute runs on graceful shutdown,
# but if the process is kill -9'd we have to mop up.
clean_routing() {
    # Native TCP/UDP TPROXY. Detach hooks before flushing policy routes.
    while iptables -t mangle -D OUTPUT -j VLESS_OUTPUT 2>/dev/null; do :; done
    while iptables -D INPUT -j VLESS_IN 2>/dev/null; do :; done
    while iptables -t mangle -D INPUT -j VLESS_IN 2>/dev/null; do :; done
    for iface in br0 br-lan lo; do
        while iptables -t mangle -D PREROUTING -i "$iface" -j VLESS_TPROXY 2>/dev/null; do :; done
    done
    iptables -t mangle -F VLESS_OUTPUT 2>/dev/null
    iptables -t mangle -X VLESS_OUTPUT 2>/dev/null
    iptables -t mangle -F VLESS_PROBE 2>/dev/null
    iptables -t mangle -X VLESS_PROBE 2>/dev/null
    iptables -t mangle -F VLESS_IN 2>/dev/null
    iptables -t mangle -X VLESS_IN 2>/dev/null
    iptables -F VLESS_IN 2>/dev/null
    iptables -X VLESS_IN 2>/dev/null
    # Remove legacy kernel TCP REDIRECT rules during upgrades.
    for iface in br0 br-lan; do
        while iptables -t nat -D PREROUTING -i "$iface" -p tcp -j VLESS_TCP 2>/dev/null; do :; done
    done
    while iptables -t nat -D OUTPUT -p tcp -j VLESS_TCP 2>/dev/null; do :; done
    iptables -t nat -F VLESS_TCP 2>/dev/null
    iptables -t nat -X VLESS_TCP 2>/dev/null
    while iptables -D INPUT -p tcp --dport 7892 -j VLESS_TCP_IN 2>/dev/null; do :; done
    iptables -F VLESS_TCP_IN 2>/dev/null
    iptables -X VLESS_TCP_IN 2>/dev/null
    # Legacy TUN rules; upgrades must remove the old capture path.
    iptables -t mangle -D PREROUTING -i br0 -j VLESS_TPROXY 2>/dev/null
    iptables -t mangle -D OUTPUT -j VLESS_TPROXY 2>/dev/null
    iptables -t mangle -F VLESS_TPROXY 2>/dev/null
    iptables -t mangle -X VLESS_TPROXY 2>/dev/null
    ip rule del fwmark 0x1 lookup 100 2>/dev/null
    ip rule del fwmark 0x9911 lookup main 2>/dev/null
    ip route flush table 100 2>/dev/null
    # TUN-mode INPUT/FORWARD/POSTROUTING rules
    iptables -D INPUT -i tun0 -j ACCEPT 2>/dev/null
    iptables -D FORWARD -i br0 -o tun0 -j ACCEPT 2>/dev/null
    iptables -D FORWARD -i tun0 -j ACCEPT 2>/dev/null
    iptables -t nat -D POSTROUTING -o tun0 -j RETURN 2>/dev/null
    ip link del tun0 2>/dev/null

    # Legacy TPROXY-mode DIVERT chain (pre-1.5 builds)
    iptables -t mangle -D PREROUTING -p tcp -m socket -j VLESS_DIVERT 2>/dev/null
    iptables -t mangle -D PREROUTING -p udp -m socket -j VLESS_DIVERT 2>/dev/null
    iptables -t mangle -F VLESS_DIVERT 2>/dev/null
    iptables -t mangle -X VLESS_DIVERT 2>/dev/null
    # Remove legacy br-lan rule (pre-1.4.1 builds used wrong interface name)
    iptables -t mangle -D PREROUTING -i br-lan -j VLESS_TPROXY 2>/dev/null
    ip rule del fwmark 0x1/0x1 lookup 100 2>/dev/null

    # Legacy NAT REDIRECT chain (pre-1.3 builds)
    iptables -t nat -D PREROUTING -i br0 -j VLESS_REDIR 2>/dev/null
    iptables -t nat -F VLESS_REDIR 2>/dev/null
    iptables -t nat -X VLESS_REDIR 2>/dev/null

    # Legacy TUN-mode ip-rule artifacts (pre-1.2 builds)
    # Do not delete rules by preference: they may belong to Keenetic.
    iptables -t nat -D POSTROUTING -o tun0 -j MASQUERADE 2>/dev/null
}

start() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat $PID_FILE)" 2>/dev/null; then
        echo "vless-manager already running"
        return 0
    fi
    clean_routing
    echo "Starting vless-manager..."
    PID_FILE="$RUNTIME_DIR/manager.pid"
    mkdir -p "$DATA_DIR" "$RUNTIME_DIR" || return 1
    chmod 700 "$RUNTIME_DIR" || return 1
    if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE")" -gt "$MAX_LOG_BYTES" ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.1"
    fi
    set -- -data-dir "$DATA_DIR" -runtime-dir "$RUNTIME_DIR"
    if [ "${VLESS_MANAGER_DIAGNOSTICS:-0}" = "1" ]; then
        set -- "$@" -diagnostics
    fi
    "$BIN" "$@" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "Started (PID $!)"
}

stop() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "Stopping vless-manager (PID $PID)..."
            kill "$PID"
            sleep 1
            kill -0 "$PID" 2>/dev/null && kill -9 "$PID"
        fi
        rm -f "$PID_FILE"
    fi
    clean_routing
    echo "Stopped"
}

status() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat $PID_FILE)" 2>/dev/null; then
        echo "vless-manager running (PID $(cat $PID_FILE))"
        else
            echo "vless-manager stopped"
            return 1
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
