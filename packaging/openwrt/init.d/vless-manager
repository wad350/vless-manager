#!/bin/sh /etc/rc.common
# procd init script for OpenWrt.

START=99
STOP=10
USE_PROCD=1

BIN=/usr/bin/vless-manager
SINGBOX=/usr/bin/sing-box
DATA_DIR=/etc/vless-manager
LOG_FILE=/var/log/vless-manager.log

# clean_routing — remove everything the manager may have installed.
# Manager's own DisableGlobalRoute runs on graceful shutdown; this is
# the belt-and-suspenders cleanup for crash/kill -9 paths.
clean_routing() {
    iptables -t mangle -D PREROUTING -p tcp -m socket -j VLESS_DIVERT 2>/dev/null
    iptables -t mangle -D PREROUTING -p udp -m socket -j VLESS_DIVERT 2>/dev/null
    iptables -t mangle -D PREROUTING -i br0 -j VLESS_TPROXY 2>/dev/null
    iptables -t mangle -D PREROUTING -i br-lan -j VLESS_TPROXY 2>/dev/null
    iptables -t mangle -D OUTPUT -j VLESS_TPROXY 2>/dev/null
    iptables -t mangle -F VLESS_TPROXY 2>/dev/null
    iptables -t mangle -X VLESS_TPROXY 2>/dev/null
    iptables -t mangle -F VLESS_DIVERT 2>/dev/null
    iptables -t mangle -X VLESS_DIVERT 2>/dev/null
    ip rule del fwmark 0x1 lookup 100 2>/dev/null
    ip rule del fwmark 0x1/0x1 lookup 100 2>/dev/null
    ip rule del fwmark 0x9911 lookup main 2>/dev/null
    ip route flush table 100 2>/dev/null
}

start_service() {
    mkdir -p "$DATA_DIR" /var/log

    procd_open_instance
    procd_set_param command "$BIN" -data-dir "$DATA_DIR" -sing-box "$SINGBOX"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$DATA_DIR/config.json"
    procd_set_param respawn 3600 5 5
    # Raise OS FD limit on the child too (manager bumps fs.file-max system-wide,
    # this is the per-process soft limit for sing-box children).
    procd_set_param limits nofile="65536 65536"
    procd_close_instance
}

stop_service() {
    # sing-box is started as a child by the manager — kill leftovers explicitly.
    killall sing-box 2>/dev/null
    clean_routing
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "vless-manager"
}
