{
  "log": {
    "level": "error"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "default"
      }
    ]
  },
  "inbounds": [
    {
      "type": "snell",
      "tag": "snell-in",
      "listen": "::",
      "listen_port": 8443,
      "psk": "your-secret-psk",
      "version": 4, // 4 | 5 (server supports v4/v5 only)
      "network": ["tcp", "udp"]
      // "obfs": {
      //   "mode": "tls", // tls | http
      //   "host": "bing.com"
      // }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct",
    "default_domain_resolver": "default",
    "auto_detect_interface": true
  }
}
